# Google Sheets credentials
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/your/service-account-key.json

# Your Google Sheet ID (from the URL: .../spreadsheets/d/<ID>/edit)
APPLE_SPREADSHEET_ID=<YOUR_SHEET_ID>

# Optional: override the tab name if yours isn't "apples"
# APPLE_SHEET_NAME=apples

# AI & enrichment APIs
OPENROUTER_API_KEY=sk-or-...
TAVILY_API_KEY=tvly-...

# Optional: override the OpenRouter model (default: openai/gpt-4.1-mini)
# OPENROUTER_MODEL=openai/gpt-4.1-mini
